{{!-- about.hbs --}}
<section id="contents" class="box">
  <div>
    <div class="body">
      <h1>{{title}}</h1>
      <h2>{{tagline}}</h2>

      <p>{{mission}}</p>

      <hr>

      <div class="ads">
        <h2>Our Crew</h2>
        <p>{{crewNote}}</p>

        <h2>How We Work</h2>
        <ul>
          {{#each values}}
            <li><strong>{{k}}:</strong> {{v}}</li>
          {{/each}}
        </ul>
      </div>

      <h2>Template details</h2>
      <p>
        This site started from a Free Website Templates theme and was customized for Travlr Getaways.
        Content here reflects sample coursework data.
      </p>
    </div>
  </div>
</section>