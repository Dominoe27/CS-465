{{!-- app_server/views/travel.hbs --}}
<div id="contents">
  <div class="box">
    <div>
      <div class="body">
        <h1>{{title}}</h1>

        {{!-- render trips from data/trips.json; use length so empty arrays show the fallback --}}
        {{#if trips.length}}
          <ul id="sites">
            {{#each trips}}
              <li>
                <a href="/travel">
                  <img src="/images/{{image}}" alt="{{name}}" loading="lazy">
                </a>
                <h2><a href="/travel">{{name}}</a></h2>
                <p>{{description}}</p>
                <p>
                  Starts {{start}} • {{length}} nights • {{location}} •
                  ${{price}}{{#if perPerson}} per person{{/if}}
                </p>
              </li>
            {{/each}}
          </ul>
        {{else}}
          <ul id="sites">
            <li>No trips available.</li>
          </ul>
        {{/if}}
      </div>
    </div>
  </div>
</div>
