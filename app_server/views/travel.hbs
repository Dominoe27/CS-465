{{!-- app_server/views/travel.hbs --}}
<div id="contents">
  <div class="box">
    <div>
      <div class="body">
        <h1>{{title}}</h1>

        {{#if message}}
          <p>{{message}}</p>
        {{/if}}

        {{#if trips.length}}
          <ul id="sites">
            {{#each trips}}
              <li>
                {{!-- during dev, make the image link show the raw API doc for quick checks --}}
                <a href="/api/trips/{{code}}">
                  <img src="/images/{{image}}" alt="{{name}}" loading="lazy">
                </a>
                <h2><a href="/api/trips/{{code}}">{{name}}</a></h2>
                <p>{{description}}</p>
                <p>
                  Starts {{start}} • {{length}} nights • {{resort}} •
                  ${{price}}{{#if perPerson}} per person{{/if}}
                </p>
              </li>
            {{/each}}
          </ul>
        {{else}}
          <ul id="sites">
            <li>No trips available.</li>
          </ul>
        {{/if}}
      </div>
    </div>
  </div>
</div>